{
  "name": "klirline-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Centre de contrôle de Klirline Inc. — entreprise virtuelle opérée par des agents sous l'autorité du CEO.",
  "scripts": {
    "start": "node src/server.js",
    "check": "node src/self-check.js",
    "check:hq": "node scripts/hq-flow.mjs",
    "check:do": "node scripts/hq-do-check.mjs",
    "check:identities": "node scripts/hq-identity-check.mjs --env",
    "stage": "node scripts/stage-assets.mjs",
    "deploy": "node scripts/stage-assets.mjs && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.135.0"
  }
}
